<html>

<head>
    <link rel="stylesheet" href="/style.css">
    <title>Mini-message Board</title>
</head>

<body>
    <form method="POST" action="/messages/new">
        <label for="name">your name
            <input type="text" id="name" name="messageUser" maxlength="20">
        </label>
        <label for="message">
            your message
            <textarea name="messageText" id="message" rows="5" cols="33"></textarea>
        </label>
        <button type="submit">Submit Message</button>
    </form>
    <a href="/">Home Page</a>
</body>

</html>