<html>
    <head>
        <link rel="stylesheet" href="/style.css">
        <title>Mini-message Board</title>
    </head>
    <body>
        <ul>
            <% messages.forEach(message => { %>
                <li><%-  message.user + ': ' + message.text %></li>
            <% }) %>
        </ul>
        <a href="/new">New message</a>
    </body>
</html>