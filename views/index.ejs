<html>

<head>
    <link rel="stylesheet" href="/style.css">
    <title>Mini-message Board</title>
</head>

<body>
    <ul>
        <% messages.forEach(message=> { %>
            <a href="/messages/<%= message.id %>">
                <li>
                    <div class="messageInfo">
                        <div class="nameContainer"><%- message.user %></div>
                        <div class="dateContainer"><%- message.added %></div>
                    </div>
                    <div class="messageText">
                        <%- message.text %>
                    </div>
                </li>
            </a>
            <% }) %>
    </ul>
    <a href="/messages/new">New message</a>
</body>

</html>